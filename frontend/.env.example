# Static export = ці значення вшиваються в білд на етапі `npm run build`.
# Зміна значення вимагає ребілду + редеплою.

# Продакшн-приклади нижче — плейсхолдер-домен, поки не зареєстрований
# реальний (TECH.md §12). Для локальної розробки проти бекенда, що
# піднятий локально (`../backend`, HOST=127.0.0.1 PORT=8080 з його
# .env.example), скопіюй цей файл у `.env.local` і зміни на:
#   NEXT_PUBLIC_BACKEND_WS_URL=ws://127.0.0.1:8080/terminal
#   NEXT_PUBLIC_BACKEND_HTTP_URL=http://127.0.0.1:8080

NEXT_PUBLIC_BACKEND_WS_URL=wss://api.example.com/terminal
NEXT_PUBLIC_BACKEND_HTTP_URL=https://api.example.com

# Публічний Turnstile site key (не секретний) з Cloudflare dashboard —
# TURNSTILE_SECRET_KEY лишається тільки на бекенді, сюди не потрапляє.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=changeme
