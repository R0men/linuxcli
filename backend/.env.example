HOST=127.0.0.1
PORT=8080

# Домен(и) фронтенда, звідки дозволено відкривати WS-сесію, через кому.
# Порожньо = дозволити будь-який Origin (тільки для локальної розробки).
ALLOWED_ORIGINS=https://linuxcli.xyz

MONGO_URL=mongodb://localhost:27017
MONGO_DB=linuxcli

REDIS_URL=redis://localhost:6379

DOCKER_SOCKET=/var/run/docker.sock
SANDBOX_IMAGE=linuxcli-sandbox:latest
SANDBOX_NETWORK=linuxcli-sandbox-net
SANDBOX_POOL_MIN=10
SANDBOX_POOL_LOW_WATERMARK=5
# Жёсткий потолок суммарного числа живых sandbox-контейнеров (idle +
# выданных). По умолчанию 3x SANDBOX_POOL_MIN, если не задано явно.
SANDBOX_MAX_CONCURRENT=30

COMMAND_TIMEOUT_MS=20000
MAX_OUTPUT_BYTES=262144
WS_MAX_PAYLOAD_BYTES=16384

RATE_LIMIT_ANON_PER_MIN=20
RATE_LIMIT_ANON_PER_HOUR=200
RATE_LIMIT_KEY_PER_MIN=60
RATE_LIMIT_KEY_PER_HOUR=1000

TURNSTILE_SECRET_KEY=changeme
TURNSTILE_REQUIRED_EVERY_N_COMMANDS=20
TURNSTILE_REQUIRED_EVERY_MS=1800000
TURNSTILE_VERIFY_TIMEOUT_MS=5000

IP_HASH_SECRET=changeme-generate-a-real-random-secret

# Публічні базові URL: перший — для OAuth redirect_uri (мають точно
# збігатись зі значенням, зареєстрованим у GitHub/Google), другий — куди
# бекенд редіректить браузер після успішного register/login/oauth.
PUBLIC_API_URL=https://api.linuxcli.xyz
FRONTEND_URL=https://linuxcli.xyz

# GitHub OAuth App (github.com/settings/developers) і Google Cloud OAuth
# client (console.cloud.google.com) — без обох пар кнопка відповідного
# провайдера просто не з'являється на /login, реєстрація/логін email+
# пароль працюють незалежно від цього.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cost-параметр scrypt для хешування паролів (не для API-key токенів —
# ті лишаються на sha256, TTL-lookup, а не memory-hard KDF). Вищий N —
# дорожчий offline brute-force при витоку бази, і повільніший кожен
# register/login (сотні мс при дефолті).
SCRYPT_COST=32768

AUDIT_LOG_RETENTION_SECONDS=7776000

# Sliding TTL API-ключа: продлевается при каждом использовании, протухает
# при простое. Заодно ограничивает на 1 активный ключ на IP одновременно.
API_KEY_IDLE_TTL_SECONDS=86400
